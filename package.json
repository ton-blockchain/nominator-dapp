{
  "name": "nominator-pool-dapp",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "author": "TON Core",
  "scripts": {
    "dev": "npm run gen-wrappers && vite",
    "gen-wrappers": "acton --project-root contract build && acton --project-root contract wrapper Pool --ts --output-dir wrappers-ts",
    "build": "npm run gen-wrappers && vite build && node --env-file-if-exists=.env scripts/write-manifest.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "test": "acton --project-root contract test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.5",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@tonconnect/ui-react": "^2.4.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.0.16"
  }
}
