# Copy this file to .env for local Toncenter API keys.
# The Vite app reads TONCENTER_ variables because vite.config.ts allows the prefix.
# Uncomment the network keys you need:
# TONCENTER_MAINNET_API_KEY="your-mainnet-key-here"
# TONCENTER_TESTNET_API_KEY="your-testnet-key-here"
# Required by `npm run build` (scripts/write-manifest.js) to generate the
# TonConnect manifest for the custom Pages domain:
#VITE_DEPLOY_ORIGIN="https://nominator.ton.org"
